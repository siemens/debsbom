{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/siemens/debsbom/refs/heads/main/src/debsbom/schema/schema-filter-report.json",
  "title": "Exclusion Report",
  "description": "The result of excluding packages from an SBOM.",
  "type": "object",
  "$defs": {
    "package": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the package."
        },
        "version": {
          "type": "string",
          "description": "The version of the package."
        },
        "arch": {
          "type": "string",
          "description": "The binary architecture, or source for a source package."
        }
      },
      "required": [
        "name",
        "version",
        "arch"
      ]
    },
    "refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "properties": {
    "matched_patterns": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Exclusion patterns that matched at least one package."
    },
    "unmatched_patterns": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Exclusion patterns that did not match any package."
    },
    "matched_packages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/package"
      },
      "description": "Exact package exclusions that matched a package."
    },
    "unmatched_packages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/package"
      },
      "description": "Exact package exclusions that did not match any package."
    },
    "removed_binaries": {
      "$ref": "#/$defs/refs",
      "description": "References of the removed binary packages."
    },
    "removed_sources": {
      "$ref": "#/$defs/refs",
      "description": "References of the removed packages."
    }
  },
  "required": [
    "matched_patterns",
    "unmatched_patterns",
    "matched_packages",
    "unmatched_packages",
    "removed_binaries",
    "removed_sources"
  ]
}
